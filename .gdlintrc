# GDLint configuration for the current gdtoolkit CLI.
# Keep this scoped to checks the repository can pass today.
disable:
  - class-definitions-order
  - function-arguments-number
  - function-preload-variable-name
  - function-variable-name
  - max-file-lines
  - max-line-length
  - max-public-methods
  - max-returns
  - mixed-tabs-and-spaces
  - no-elif-return
  - no-else-return
  - trailing-whitespace
  - unnecessary-pass
  - unused-argument

excluded_directories: !!set
  .git: null
  .godot: null
  addons: null
  tests: null

tab-characters: 1
