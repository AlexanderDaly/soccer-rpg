# EditorConfig - https://editorconfig.org
# Consistent coding styles across editors and IDEs

root = true

[*]
indent_style = tab
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# GDScript files
[*.gd]
indent_style = tab
indent_size = 4

# Godot scene/resource files
[*.{tscn,tres}]
indent_style = space
indent_size = 4

# Godot project file
[project.godot]
indent_style = space

# JSON files
[*.json]
indent_style = space
indent_size = 2

# YAML files (GitHub Actions, etc.)
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Markdown files
[*.md]
trim_trailing_whitespace = false

# Shell scripts
[*.sh]
indent_style = space
indent_size = 2
